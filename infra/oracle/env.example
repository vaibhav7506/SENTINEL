# Generate private .env.oracle; target is Oracle Ampere A1 ARM64.
SENTINEL_DOMAIN=sentinel.example.com
DATABASE_URL=
REDIS_PASSWORD=
INTEGRATION_ENCRYPTION_KEY=
SAAS_ALERT_ALLOWED_HOSTS=["hooks.slack.com"]
METRIC_RETENTION_DAYS=30
# Select immutable image digests after CI succeeds.
SENTINEL_API_IMAGE=sentinel-api-arm64:local
SENTINEL_PUSH_IMAGE=sentinel-push-arm64:local
SENTINEL_FRONTEND_IMAGE=sentinel-frontend-arm64:local
SENTINEL_ALLOY_IMAGE=
GRAFANA_CLOUD_REMOTE_WRITE_URL=
GRAFANA_CLOUD_METRICS_INSTANCE_ID=
GRAFANA_CLOUD_METRICS_WRITE_TOKEN=
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
