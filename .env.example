# Local development stack. Generate .env using scripts/init_env.py; do not commit .env.
ENVIRONMENT=development
API_READ_TOKEN=
POSTGRES_SSLMODE=disable
LOG_LEVEL=INFO
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=
PROMETHEUS_URL=http://localhost:9090
# Grafana Cloud: use its Metrics query endpoint, instance ID and metrics:read token.
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=
PROMETHEUS_READINESS_MODE=local
READINESS_TIMEOUT_SECONDS=3
WORKER_HEARTBEAT_SECONDS=30
GRAFANA_ADMIN_USER=sentinel
GRAFANA_ADMIN_PASSWORD=
API_PORT=8000
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=4300
DEMO_PORT=8001

# Local executable agent (Docker agent identity is set separately in Compose)
HOST_ID=windows-workstation
HOST_NAME=Windows workstation
AGENT_PORT=9101
AGENT_BIND_ADDRESS=127.0.0.1
AGENT_SAMPLE_SECONDS=5
AGENT_DISK_PATH=/

# Phase 3 feature windows; map services only to hosts they actually run on.
FEATURE_INTERVAL_SECONDS=60
FEATURE_WINDOW_SECONDS=900
FEATURE_FRESHNESS_SECONDS=90
FEATURE_QUERY_TIMEOUT_SECONDS=15
FEATURE_HOST_SERVICE_MAP={"docker-vm":"demo-service"}

# Chaos stays disabled until explicitly enabled for the allowlisted local demo.
CHAOS_ENABLED=false
CHAOS_ALLOWED_ENVIRONMENTS=[]
CHAOS_ALLOWED_NAMESPACES=[]
CHAOS_ALLOWED_TARGETS=[]
CHAOS_CONTROL_TOKEN=
OBSERVATION_INTERVAL_SECONDS=2
OBSERVATION_LATENCY_SLO_SECONDS=0.5
PREDICTION_HORIZON_SECONDS=600
DATASET_RECOVERY_EXCLUSION_SECONDS=900

# Native Phase 6 worker uses a separate inference environment. URLs are optional.
INFERENCE_MODEL_PATH=artifacts/models/20260926T204848-mlp-1bcd8acd
INFERENCE_POLL_SECONDS=5
INFERENCE_MAX_AGE_SECONDS=90
INFERENCE_METRICS_PORT=8004
ALERT_COOLDOWN_SECONDS=300
ALERT_GENERIC_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
DASHBOARD_URL=http://127.0.0.1:5173
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional advisory intake. Phase 7 provides a clearly labeled mock only.
RUNBOOKOS_ENABLED=false
RUNBOOKOS_BASE_URL=
RUNBOOKOS_API_KEY=
RUNBOOKOS_ADAPTER=mock
RUNBOOKOS_PROPOSAL_THRESHOLD=0.995
